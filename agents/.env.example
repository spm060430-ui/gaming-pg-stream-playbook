# Copy to agents/.env (or export in your shell) before a non-dry run.
#
# The Anthropic API key each agent uses to make decisions. Without it, only
# --dry runs work (they use a deterministic stub instead of calling Claude).
ANTHROPIC_API_KEY=

# Optional: override the model all agents use. Defaults to claude-opus-5.
# A cheaper/faster model is reasonable for high-frequency decisions.
# AI_STATION_MODEL=claude-haiku-4-5
