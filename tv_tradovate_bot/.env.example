# =============================================================================
# Copy to .env and fill in. NEVER commit your real .env (see .gitignore).
# =============================================================================

# --- Instruments -------------------------------------------------------------
WATCHLIST=MNQ,MGC

# --- Strategy (keep in sync with the Pine inputs) ----------------------------
EMA_FAST=10
EMA_SLOW=30
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ALLOW_SHORTS=false

# --- Risk --------------------------------------------------------------------
MAX_OPEN_POSITIONS=2
MAX_CONTRACTS_PER_SYMBOL=2
STOP_MODE=atr            # atr | points | percent
STOP_ATR_MULT=2.0
RISK_PER_TRADE_PCT=0.01  # risk 1% of equity per trade
MAX_MARGIN_PCT=0.5
MIN_HOLD_DAYS=1          # swing: never a same-day round trip
DAILY_MAX_LOSS_PCT=0.05
WEEKLY_MAX_LOSS_PCT=0.08

# --- Relay -------------------------------------------------------------------
RELAY_HOST=0.0.0.0
RELAY_PORT=8000
RELAY_DRY_RUN=true        # true = compute+log decisions, place NO live orders
WEBHOOK_SECRET=change-me-to-a-long-random-string
DRY_RUN_EQUITY=3000       # equity assumed for sizing when no broker is wired

# --- Tradovate ---------------------------------------------------------------
TRADOVATE_ENV=demo        # demo (practice) | live (real money)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_ACCOUNT_SPEC=   # e.g. DEMO1234567; blank = first account found

# --- Alerts (optional email) -------------------------------------------------
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
